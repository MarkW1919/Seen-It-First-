[Unit]
Description=RepoScan Pro - Camera Service
After=reposcan.service
PartOf=reposcan.service

[Service]
Type=simple
WorkingDirectory=/opt/reposcan
ExecStart=/usr/bin/docker compose up camera
ExecStop=/usr/bin/docker compose stop camera
Restart=on-failure
RestartSec=10

[Install]
WantedBy=reposcan.service
