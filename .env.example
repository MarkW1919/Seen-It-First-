# ─── RepoScan Pro Environment Configuration ───

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=reposcan
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=reposcan

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
SECRET_KEY=change-this-to-a-random-secret-key
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Pipeline
AI_DEVICE=cuda
AI_PRECISION=fp16
DETECTION_CONFIDENCE=0.5
PLATE_CONFIDENCE=0.6
OCR_CONFIDENCE=0.7

# Camera
CAMERA_SOURCE=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
RTSP_PORT=8554

# Map (Leaflet uses free OpenStreetMap tiles - no key needed)
MAP_DEFAULT_LAT=39.8283
MAP_DEFAULT_LNG=-98.5795
MAP_DEFAULT_ZOOM=5

# Alerts
ALERT_SOUND_ENABLED=true
ALERT_VIBRATION_ENABLED=true

# Storage
DATA_DIR=/data
CAPTURE_RETENTION_DAYS=30
